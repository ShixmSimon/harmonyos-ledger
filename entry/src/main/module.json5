{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:bluetooth_subscription_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": ["EntryAbility"]
        }
      },
      {
        "name": "ohos.permission.SUBSCRIBE_NOTIFICATION",
        "reason": "$string:SUBSCRIBE_NOTIFICATION_reason1",
        "usedScene": {
          "when": "always",
          "abilities": ["EntryAbility", "NotificationProbeExtension"]
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "ShareImportExtension",
        "srcEntry": "./ets/extensionability/ShareImportExtension.ets",
        "type": "share",
        "description": "接收账单截图并导入记账复核",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "exported": true,
        "skills": [
          {
            "actions": ["ohos.want.action.sendData"],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.image",
                "maxFileSupported": 20
              }
            ]
          }
        ]
      },
      {
        "name": "NotificationProbeExtension",
        "srcEntry": "./ets/extensionability/NotificationProbeExtension.ets",
        "type": "notificationSubscriber",
        "description": "接收通知并按银行规则自动记账",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "exported": true
      }
    ]
  }
}
